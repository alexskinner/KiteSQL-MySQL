# AVG of an exact-value argument (integer or DECIMAL) is DECIMAL with div_precision_increment (4)
# more digits of scale, rounded half away from zero; FLOAT/DOUBLE and string arguments give DOUBLE.
# NULLs are skipped; no rows, or only NULLs, give NULL. Expected values are MySQL 8.0.40 output.

statement ok
CREATE TABLE av (id INT PRIMARY KEY, g INT, n INT, d DECIMAL(10,2), f DOUBLE, s VARCHAR(10), ti TINYINT, bi BIGINT, ub BIGINT UNSIGNED, dd DECIMAL(5), b BOOLEAN)

statement ok
INSERT INTO av VALUES (1, 1, 1, 1.25, 1.5, '1.5', 1, 10, 10, 1, true), (2, 1, 2, 2.50, 2.5, '2', 2, 20, 20, 2, false), (3, 1, 2, NULL, 0.5, NULL, 2, NULL, NULL, 2, true), (4, 2, -1, -1.05, NULL, NULL, -1, -10, 5, -1, NULL), (5, 2, -2, -2.10, NULL, NULL, -2, -20, 6, -2, false), (6, 3, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)

query RRRRRRRRR
SELECT AVG(n), AVG(d), AVG(f), AVG(s), AVG(ti), AVG(bi), AVG(ub), AVG(dd), AVG(b) FROM av
----
0.4000 0.150000 1.5 1.75 0.4000 0.0000 10.2500 0.4000 0.5000

query IRRRI
SELECT g, AVG(n), AVG(d), AVG(DISTINCT n), COUNT(n) FROM av GROUP BY g ORDER BY g
----
1 1.6667 1.875000 1.5000 3
2 -1.5000 -1.575000 -1.5000 2
3 NULL NULL NULL 0

query RR
SELECT AVG(DISTINCT n), AVG(DISTINCT d) FROM av
----
0.0000 0.150000

query RR
SELECT AVG(n), AVG(d) FROM av WHERE id > 100
----
NULL NULL

query R
SELECT AVG(n) FROM av WHERE g = 3
----
NULL

query R
SELECT AVG(n) FROM av WHERE n < 0 OR id = 3
----
-0.3333

query IR
SELECT id, AVG(n) OVER (PARTITION BY g) FROM av ORDER BY id
----
1 1.6667
2 1.6667
3 1.6667
4 -1.5000
5 -1.5000
6 NULL

query I
SELECT g FROM av GROUP BY g HAVING AVG(n) > 1
----
1

query RR
SELECT AVG(n) + 1, AVG(d) + 1 FROM av
----
1.4000 1.150000

statement ok
CREATE TABLE r (id INT PRIMARY KEY, v DECIMAL(10,2), w SMALLINT)

statement ok
INSERT INTO r VALUES (1, 0.01, 1), (2, 0, 1), (3, 0, 1), (4, 0, 1), (5, 0, 1), (6, 0, 1), (7, 0, 1), (8, 0, 1), (9, 0, 1), (10, 0, 1), (11, 0, 1), (12, 0, 1), (13, 0, 1), (14, 0, 1), (15, 0, 1), (16, 0, 1), (17, 0, 1), (18, 0, 1), (19, 0, 1), (20, 0, 1), (21, 0, 1), (22, 0, 1), (23, 0, 1), (24, 0, 1), (25, 0, 1), (26, 0, 1), (27, 0, 1), (28, 0, 1), (29, 0, 1), (30, 0, 1), (31, 0, 1), (32, 0, 1)

# 0.01 / 32 = 0.0003125: half away from zero at scale 6
query RRR
SELECT AVG(v), AVG(0 - v), AVG(w) FROM r
----
0.000313 -0.000313 1.0000

statement ok
DROP TABLE r

statement ok
DROP TABLE av
