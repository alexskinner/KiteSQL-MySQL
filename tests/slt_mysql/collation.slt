CREATE TABLE uq (id INT PRIMARY KEY, name VARCHAR(20), UNIQUE KEY uq_name (name))

statement ok
INSERT INTO uq VALUES (1, 'Smith')

# MySQL: ERROR 1062: Duplicate entry 'SMITH' for key 'uq.uq_name'
statement error
INSERT INTO uq VALUES (2, 'SMITH')

# MySQL: ERROR 1062: Duplicate entry 'smíth' for key 'uq.uq_name'
statement error
INSERT INTO uq VALUES (3, 'smíth')

statement ok
INSERT INTO uq VALUES (4, 'Smith ')

query T
SELECT id FROM uq WHERE name = 'smith'
----
1

query T
SELECT id FROM uq WHERE name = 'SMITH '
----
4

statement ok
UPDATE uq SET name = 'Jones' WHERE name = 'SMITH'

query TT
SELECT id, name FROM uq ORDER BY id
----
1 Jones
4 Smith

# MySQL: ERROR 1062: Duplicate entry 'JONES' for key 'uq.uq_name'
statement error
INSERT INTO uq VALUES (5, 'JONES')

statement ok
CREATE TABLE pk (code VARCHAR(10) PRIMARY KEY, n INT)

statement ok
INSERT INTO pk VALUES ('abc', 1), ('Straße', 2)

# MySQL: ERROR 1062: Duplicate entry 'ABC' for key 'pk.PRIMARY'
statement error
INSERT INTO pk VALUES ('ABC', 3)

# MySQL: ERROR 1062: Duplicate entry 'STRASSE' for key 'pk.PRIMARY'
statement error
INSERT INTO pk VALUES ('STRASSE', 4)

query TT
SELECT code, n FROM pk WHERE code = 'ABC'
----
abc 1

query TT
SELECT code, n FROM pk WHERE code = 'strasse'
----
Straße 2

query TT
SELECT code, n FROM pk WHERE code IN ('ABC', 'STRASSE') ORDER BY n
----
abc 1
Straße 2

statement ok
UPDATE pk SET n = 10 WHERE code = 'ABC'

statement ok
DELETE FROM pk WHERE code = 'STRASSE'

query TT
SELECT code, n FROM pk ORDER BY code
----
abc 10

statement ok
CREATE TABLE ix (id INT PRIMARY KEY, email VARCHAR(40), KEY ix_email (email))

statement ok
INSERT INTO ix VALUES (1, 'Alice@Example.com'), (2, 'bob@example.com')

query TT
SELECT id, email FROM ix WHERE email = 'alice@example.com'
----
1 Alice@Example.com

query T
SELECT email FROM ix WHERE email = 'BOB@EXAMPLE.COM'
----
bob@example.com

query T
SELECT id FROM ix WHERE email >= 'B' ORDER BY id
----
2

