# Regression tests for comparison/result type coercion (PR #41 follow-up).

statement ok
create table cc (id int primary key, f boolean null, s varchar(10) null, n int null, d datetime null, ub bigint unsigned null, sb bigint null)

statement ok
insert into cc values (1, true, '1', 1, '2026-01-01 00:00:00', 9007199254740993, 9007199254740992), (2, false, 'x', 0, null, 1, -1), (3, null, null, null, null, null, null)

# Boolean vs number compares as 0/1, in WHERE and once constant-folded.
query I rowsort
select id from cc where f = 0
----
2

query I rowsort
select id from cc where f = 1
----
1

query I rowsort
select id from cc where 1 = f
----
1

query I rowsort
select id from cc where f = n
----
1
2

query I rowsort
select id from cc where f is null or f = 0
----
2
3

query I rowsort
select id from cc where f <> 0
----
1

query I rowsort
select id from cc where f + 1 = 2
----
1

query I rowsort
select id from cc where f = '1'
----
1

# Boolean in COALESCE with a number takes the numeric type.
query I
select coalesce(f, n) from cc order by id
----
1
0
NULL

query I
select coalesce(n, f) from cc order by id
----
1
0
NULL

# Boolean mixed with text renders as '1'/'0'.
query T
select coalesce(f, s) from cc order by id
----
1
0
NULL

query T
select ifnull(f, 'z') from cc order by id
----
1
0
z

query T
select case when id = 1 then f else s end from cc order by id
----
1
x
NULL

query T rowsort
select f from cc union select s from cc
----
0
1
NULL
x

query T rowsort
select s from cc union all select f from cc
----
0
1
1
NULL
NULL
x

query T
select cast(true as varchar)
----
1

# Temporal vs number compares against the YYYYMMDDhhmmss number.
query I rowsort
select id from cc where d = 20260101000000
----
1

query I rowsort
select id from cc where d > 0
----
1

query I rowsort
select id from cc where d < 20260101000001
----
1

query I rowsort
select id from cc where d = 1.5
----

query I rowsort
select id from cc where d = '2026-01-01 00:00:00'
----
1

query I
select cast(cast('2026-03-04' as date) as bigint)
----
20260304

# BIGINT UNSIGNED vs BIGINT compares exactly, not through DOUBLE.
query I rowsort
select id from cc where ub = 9007199254740992
----

query I rowsort
select id from cc where ub = 9007199254740993
----
1

query I rowsort
select id from cc where ub > sb
----
1
2

query I rowsort
select id from cc where ub = sb + 1
----
1

# Incomparable pairs still fail cleanly.
statement error
select id from cc where d = f

# CMS admin user 2FA migration shape.
statement ok
create table su (id varchar(35) primary key, mfa_enabled boolean null, mfa_key varchar(255) null, mfa_key_created datetime null, mfa_key_in_use boolean null)

statement ok
insert into su values ('a', null, 'k1', '2026-01-01 00:00:00', true), ('b', false, 'k2', '2026-01-01 00:00:00', true), ('c', true, 'k3', '2026-01-01 00:00:00', true), ('d', false, 'k4', null, false)

statement ok
UPDATE su SET mfa_key = NULL, mfa_key_created = NULL, mfa_key_in_use = 0 WHERE ( mfa_enabled IS NULL OR mfa_enabled = 0 ) AND mfa_key_in_use = 1

query TTB rowsort
select id, mfa_key, mfa_key_in_use from su
----
a NULL false
b NULL false
c k3 true
d k4 false

statement ok
drop table su

statement ok
drop table cc
