CREATE TABLE m (id INT PRIMARY KEY, d DECIMAL(10,2), f DOUBLE)

statement ok
INSERT INTO m VALUES (1, 0.125, 0.1), (2, 1e2, 1.5), (3, 2, 0.1 + 0.2), (4, 1 / 4, 1 / 4)

query TTT rowsort
SELECT id, d, f FROM m
----
1 0.13 0.1
2 100.00 1.5
3 2.00 0.3
4 0.25 0.25

statement ok
UPDATE m SET d = d / 3, f = f * 2 WHERE id = 3

query TTT rowsort
