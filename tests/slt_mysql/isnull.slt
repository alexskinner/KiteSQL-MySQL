# ISNULL(expr): MySQL's NULL test function. It returns the integer 1 when expr is NULL and 0
# otherwise, never NULL, for any argument type. Expected values are MySQL 8.0.40 output.

statement ok
CREATE TABLE isn_t (id INT PRIMARY KEY, k VARCHAR(20), u INT, d DECIMAL(5,2), bf BOOLEAN)

statement ok
INSERT INTO isn_t VALUES (1,NULL,1,1.50,TRUE),(2,'abc',1,NULL,TRUE),(3,'x',0,0.00,FALSE),(4,NULL,0,NULL,TRUE),(5,'',NULL,2.25,NULL)

statement ok
CREATE TABLE isn_o (id INT PRIMARY KEY, t_id INT, flag INT)

statement ok
INSERT INTO isn_o VALUES (10,1,1),(11,3,0),(12,9,1)

# Literals

query TTTTTT
SELECT ISNULL(NULL), ISNULL(1), ISNULL(''), ISNULL(0), ISNULL('abc'), ISNULL(0.0)
----
1 0 0 0 0 0

query TTT
SELECT isnull(NULL + 1), ISNULL(CONCAT('a', NULL)), ISNULL(ISNULL(NULL))
----
1 1 0

# Columns of each type

query TTTT
SELECT id, ISNULL(k), ISNULL(u), ISNULL(d) FROM isn_t ORDER BY id
----
1 1 0 0
2 0 0 1
3 0 0 0
4 1 0 1
5 0 1 0

# The result is an integer: usable in arithmetic, comparisons and SUM

query TTT
SELECT ISNULL(k) + 1, ISNULL(k) * 2, ISNULL(k) - ISNULL(u) FROM isn_t WHERE id = 1
----
2 2 1

query TTT
SELECT SUM(ISNULL(k)), SUM(ISNULL(d)), SUM(ISNULL(u)) FROM isn_t
----
2 2 1

query T
SELECT id FROM isn_t WHERE ISNULL(u) = 1 ORDER BY id
----
5

query T
SELECT id FROM isn_t WHERE ISNULL(k) = 0 ORDER BY id
----
2
3
5

# IF() over ISNULL, combined with AND as a CMS user query does

query TT
SELECT id, IF(ISNULL(k), 0, 1) FROM isn_t ORDER BY id
----
1 0
2 1
3 1
4 0
5 1

# AND, OR, NOT and WHERE take a number as a condition (true when not 0). The engine shows the
# boolean results as true/false where MySQL shows 1/0.

query TT
SELECT id, IF(ISNULL(k), 0, 1) AND u = 1 AS h FROM isn_t ORDER BY id
----
1 false
2 true
3 false
4 false
5 NULL

query TT
SELECT id, IF(ISNULL(k), 0, 1) AND bf AS h FROM isn_t ORDER BY id
----
1 false
2 true
3 false
4 false
5 NULL

query TTTT
SELECT id, IF(ISNULL(k), 0, 1) AND u, ISNULL(d) OR u, NOT ISNULL(k) FROM isn_t ORDER BY id
----
1 false true false
2 true true true
3 false false true
4 false true false
5 NULL NULL true

query T
SELECT id FROM isn_t WHERE ISNULL(k) ORDER BY id
----
1
4

query T
SELECT id FROM isn_t WHERE NOT ISNULL(k) AND u ORDER BY id
----
2

query TT
SELECT id, CASE WHEN ISNULL(d) THEN 'none' WHEN u THEN 'u' ELSE 'other' END FROM isn_t ORDER BY id
----
1 u
2 none
3 other
4 none
5 other

query TT
SELECT ISNULL(k) AS n, COUNT(*) FROM isn_t GROUP BY ISNULL(k) HAVING SUM(ISNULL(d)) ORDER BY n
----
0 3
1 2

statement ok
UPDATE isn_t SET u = 7 WHERE ISNULL(u)

statement ok
DELETE FROM isn_o WHERE ISNULL(flag) OR flag

query TT
SELECT id, u FROM isn_t ORDER BY id
----
1 1
2 1
3 0
4 0
5 7

query T
SELECT id FROM isn_o ORDER BY id
----
11

query TT
SELECT id, CASE WHEN ISNULL(d) = 1 THEN 'none' ELSE 'some' END FROM isn_t ORDER BY id
----
1 some
2 none
3 some
4 none
5 some

# Grouping and ordering by ISNULL

query TT
SELECT ISNULL(k) AS n, COUNT(*) FROM isn_t GROUP BY ISNULL(k) ORDER BY n
----
0 3
1 2

query T
SELECT id FROM isn_t ORDER BY ISNULL(d), id
----
1
3
5
2
4

# Outer join: unmatched rows are NULL

query TTT
SELECT o.id, ISNULL(t.id), ISNULL(t.k) FROM isn_o o LEFT JOIN isn_t t ON t.id = o.t_id ORDER BY o.id
----
11 0 0

# Wrong arity

# MySQL: ERROR 1582: Incorrect parameter count in the call to native function 'ISNULL'
statement error
SELECT ISNULL()

# MySQL: ERROR 1582: Incorrect parameter count in the call to native function 'ISNULL'
statement error
SELECT ISNULL(1, 2)

statement ok
DROP TABLE isn_o

statement ok
DROP TABLE isn_t
